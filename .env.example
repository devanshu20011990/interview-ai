# ─────────────────────────────────────────────────────────────
#  Interview AI Assistant — environment configuration
#  Copy this file to ".env" and fill in your key(s).
# ─────────────────────────────────────────────────────────────

# Server port
PORT=3000

# ============================================================
#  LLM PROVIDER  (required — pick ONE option below)
#  The app works with any OpenAI-compatible API.
# ============================================================

# ---- OPTION 1 (recommended, FREE): Groq ----
#  1. Sign up at https://console.groq.com  (no credit card)
#  2. Create an API key (starts with gsk_...)
#  3. Paste it below and keep these Groq settings.
OPENAI_API_KEY=gsk_your_free_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---- OPTION 2: OpenAI (paid pay-as-you-go) ----
#  OPENAI_API_KEY=sk-your-openai-key
#  OPENAI_BASE_URL=https://api.openai.com/v1
#  LLM_MODEL=gpt-4o-mini

# ---- OPTION 3: Local & fully offline (Ollama, no key) ----
#  Install from https://ollama.com, run:  ollama pull llama3.1
#  OPENAI_API_KEY=ollama            (any non-empty value works)
#  OPENAI_BASE_URL=http://localhost:11434/v1
#  LLM_MODEL=llama3.1

# Whisper model — only used by System/Tab transcription.
# Note: Groq/Ollama may not support audio transcription. Use Microphone
# mode for free transcription (it runs in your browser, no API needed).
TRANSCRIBE_MODEL=whisper-1

# ============================================================
#  WEB SEARCH  (optional)
#  You can switch search mode inside the app:
#   - "Keyless (DuckDuckGo)"  -> no key needed at all
#   - "Tavily"                -> needs the free key below
#  Get a free Tavily key (1,000 searches/month, no card): https://tavily.com
# ============================================================
TAVILY_API_KEY=
